# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/.go-cache/
/.go-mod-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/backend/bin/
/test-results/

# Backend local build/test outputs (source, tests and migrations remain tracked)
/backend/.go-cache/
/backend/.go-mod-cache/
/backend/coverage/
/backend/test-results/
/backend/tmp/
/backend/logs/
*.log
*.test
*.exe
coverage.out
*.prof

# Local notes/plans/handoffs and reserved data (not runtime dependencies)
/docs/
/data/
/notes/
/plans/
/logs/
/artifacts/
/reports/
/.agents/
/.codex/
/.vscode/
/.idea/
/GOALS.md
/PLAN.md
/TASKS.md
/TODO.md
/STATUS.md
/backend/GOALS.md
/backend/PLAN.md
/backend/TASKS.md
/backend/TODO.md
/backend/STATUS.md

# Local frontend/demo and whole-site deployment helpers
# Actual frontend backup is ../frontend/, outside this Git repository.
/frontend/
/scripts/
/Dockerfile
/.dockerignore
/compose.yaml
/compose.yml
/docker-compose.yaml
/docker-compose.yml
