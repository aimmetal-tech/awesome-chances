# 后端配置模板：在 backend/ 下复制为 .env；进程环境优先。
# 不提交真实凭据。旧项目根 .env 仍兼容，ENV_FILE 可显式指定配置文件。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

DATABASE_ENABLED=false
DATABASE_AUTO_MIGRATE=false
# PostgreSQL 连接信息留空，由使用者填写。
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=
PG_MAX_CONNS=10
PG_MIN_CONNS=1
PG_CONNECT_TIMEOUT=5s
PG_QUERY_TIMEOUT=5s
PG_MAX_CONN_LIFETIME=1h

AUTH_COOKIE_NAME=ac_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=24h
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_MAX_HASH_JOBS=2
AUTH_RATE_LIMIT_PER_MINUTE=30
# 跨源联调时填写允许的 HTTP/HTTPS origin，逗号分隔；部署使用实际 Web 域名。
# 留空时没有额外允许来源；兼容旧 WEB_HOST/WEB_PORT 配置时会推导本地来源。
AUTH_ALLOWED_ORIGINS=
